{
  "name": "balancesheet",
  "private": true,
  "version": "0.0.0",
  "description": "ASCII Tycoon — an entrepreneur clicker/idle game that grows from black-and-white ASCII into an isometric city.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
